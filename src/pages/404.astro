---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <section style="text-align: center; padding: 4rem 0;">
    <h1 style="font-size: 4rem; margin-bottom: 0.5rem;">404</h1>
    <p style="font-size: 1.1rem; color: var(--warm-500); margin-bottom: 2rem;">Page not found. Lost in the grow room?</p>
    <a href="/" class="cta" style="display: inline-block; background: var(--green-700); color: var(--white); padding: 0.85rem 2rem; border-radius: 9999px; text-decoration: none; font-weight: 600; font-size: 0.95rem;">Go Home</a>
  </section>
</BaseLayout>