<BaseLayout
  title="Articles"
  description="Indoor gardening guides, hydroponic tutorials, product reviews, and grow tips for beginners."
>
  <h1 style="margin-bottom: 2rem;">All Articles</h1>

  <ul class="post-list">
    {posts.map(post => (
      <li class="post-card">
        <div class="meta">{post.cat} · {post.date}</div>
        <h2><a href={post.url}>{post.title}</a></h2>
        <p>{post.desc}</p>
      </li>
    ))}
  </ul>
</BaseLayout>